{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerMessage",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "ClearSpectator"
      ]
    },
    {
      "type": "object",
      "required": [
        "FullState"
      ],
      "properties": {
        "FullState": {
          "$ref": "#/definitions/GameStateMessage"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "DeltaState"
      ],
      "properties": {
        "DeltaState": {
          "$ref": "#/definitions/GameDeltaMessage"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "LobbyCreated"
      ],
      "properties": {
        "LobbyCreated": {
          "type": "object",
          "required": [
            "lobby_code"
          ],
          "properties": {
            "lobby_code": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "LobbyJoined"
      ],
      "properties": {
        "LobbyJoined": {
          "type": "object",
