            "lobby_code"
          ],
          "properties": {
            "lobby_code": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "LobbyUpdate"
      ],
      "properties": {
        "LobbyUpdate": {
          "type": "object",
          "required": [
            "players",
            "settings"
          ],
          "properties": {
            "players": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LobbyPlayer"
              }
            },
            "settings": {
              "$ref": "#/definitions/LobbySettings"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "Error"
      ],
      "properties": {
        "Error": {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "LlmReasonLog"
      ],
      "properties": {
        "LlmReasonLog": {
          "type": "object",
          "required": [
            "action",
            "player_name",
            "reason"
          ],
          "properties": {
            "action": {
              "type": "string"
            },
            "player_name": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "Advice"
      ],
      "properties": {
        "Advice": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "Leaderboard"
      ],
      "properties": {
        "Leaderboard": {
          "type": "object",
          "required": [
            "entries"
          ],
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/LeaderboardEntry"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "GameOver"
      ],
      "properties": {
        "GameOver": {
          "type": "object",
          "required": [
            "game_id",
            "message",
            "winner"
          ],
          "properties": {
            "game_id": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "winner": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "CityState": {
      "type": "object",
      "required": [
        "id",
        "level",
        "manpower",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "manpower": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "position": {
          "type": "array",
          "items": [
            {
              "type": "number",
              "format": "float"
            },
            {
              "type": "number",
              "format": "float"
            }
          ],
          "maxItems": 2,
          "minItems": 2
        }
      }
    },
    "CityUpdate": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "manpower": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CityUpgradeSettings": {
      "description": "City upgrade and supply system settings. Shared between game logic and the wire protocol (see protocol.rs re-export).",
      "type": "object",
      "properties": {
        "base_supply_range": {
          "description": "Base supply range in grid cells at level 1",
          "default": 5.0,
          "type": "number",
          "format": "float"
        },
        "base_upgrade_cost": {
          "description": "Base cost for upgrades; actual cost = base_cost * level",
          "default": 200,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "enabled": {
          "description": "Whether city upgrades and supply system are enabled",
          "default": false,
          "type": "boolean"
        },
        "income_growth_per_level": {
          "description": "Additional income multiplier per level above 1",
          "default": 0.5,
          "type": "number",
          "format": "float"
        },
        "manpower_regen_per_tick": {
          "description": "Manpower generated per tick per city level. Added to global player manpower pool each economy tick.",
          "default": 10.0,
          "type": "number",
          "format": "float"
        },
        "max_level": {
          "description": "Maximum city level (default: 100)",
          "default": 100,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "secondary_city_decay": {
          "description": "Decay multiplier for non-closest city contributions (0.0 = ignored, 1.0 = equal) When a unit is within range of multiple friendly cities, the secondary city contribution = supply_rate * secondary_city_decay",
          "default": 0.5,
          "type": "number",
          "format": "float"
        },
        "supply_range_growth": {
          "description": "Additional range per level above 1",
          "default": 3.0,
          "type": "number",
          "format": "float"
        }
      }
    },
    "CustomUnitType": {
      "description": "Configuration for a custom unit type in lobby settings",
      "type": "object",
      "required": [
        "equipment",
        "hard_attack",
        "hard_defense",
        "max_organisation",
        "men",
        "name",
        "recruitment_cost",
        "reinforcement_rate",
        "soft_attack",
        "soft_defense",
        "speed",
        "symbol"
      ],
      "properties": {
        "equipment": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "format": "uint32",
                "minimum": 0.0
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "hard_attack": {
          "type": "number",
          "format": "float"
        },
        "hard_defense": {
          "type": "number",
          "format": "float"
        },
        "max_organisation": {
          "type": "number",
          "format": "float"
        },
        "men": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        },
        "recruitment_cost": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "reinforcement_rate": {
          "type": "number",
          "format": "float"
        },
        "soft_attack": {
          "type": "number",
          "format": "float"
        },
        "soft_defense": {
          "type": "number",
          "format": "float"
        },
        "speed": {
          "type": "number",
          "format": "float"
        },
        "symbol": {
          "type": "string"
        }
      }
    },
    "EquipmentState": {
      "type": "object",
      "required": [
        "cost_per_item",
        "count",
        "name"
      ],
      "properties": {
        "cost_per_item": {
          "type": "number",
          "format": "float"
        },
        "count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        }
      }
    },
    "GameDeltaMessage": {
      "type": "object",
      "required": [
        "city_updates",
        "player",
        "unit_updates",
        "units_added",
        "units_removed"
      ],
      "properties": {
        "border_cells_changed": {
          "description": "I4: sparse changed-cell list for the BORDER grid — same packed-u32 format as `vision_cells_changed` (the 8-bit value is the new player index, including 255 = no owner). Present instead of `border_grid_diff` when the change is below the ~5% threshold.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          }
        },
        "border_grid_diff": {
          "description": "Flat border/territory grid (1 byte per cell: player index 0..N or 255). Row-major, width = terrain width. `None` when unchanged.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          }
        },
        "city_updates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CityUpdate"
          }
        },
        "grid_width": {
          "description": "Grid width in cells (sent whenever either grid diff is present so the client can index the flat arrays). Omitted when no grid changed.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "player": {
          "$ref": "#/definitions/PlayerState"
        },
        "unit_updates": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UnitUpdate"
          }
        },
        "units_added": {
          "description": "Shared across all players in a tick — `Arc` so per-player delta construction is a refcount bump, not a deep clone.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/UnitState"
          }
        },
        "units_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vision_cells_changed": {
          "description": "I4: sparse changed-cell list for the VISION grid. Present *instead of* `vision_grid_diff` when fewer than ~5% of cells changed. Each entry packs the new value and the row-major cell index into one u32: `(new_value << bits) | cell_index`, `bits = ceil(log2(w*h))`. The value is always present — vision flips include 1→0 (cells becoming invisible), so a set-bit-only encoding would lose them.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          }
        },
        "vision_grid_diff": {
          "description": "Flat vision grid (1 byte per cell, 0 or 1). Row-major, width = terrain width. `None` when the grid is unchanged since the client's last snapshot. `Arc` so the per-player build shares the influence grid instead of copying 40 KB (W3); CBOR-serializes as a plain byte array.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "minimum": 0.0
          }
        }
      }
    },
    "GameStateMessage": {
      "type": "object",
      "required": [
        "cities",
        "player",
        "terrain",
        "units"
      ],
      "properties": {
        "border_grid": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          }
        },
        "cities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CityState"
          }
        },
        "player": {
          "$ref": "#/definitions/PlayerState"
        },
        "terrain": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UnitState"
          }
        },
        "vision_grid": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "LeaderboardEntry": {
      "description": "Leaderboard entry",
      "type": "object",
      "required": [
        "avg_casualties",
        "games_played",
        "games_won",
        "name",
        "player_id"
      ],
      "properties": {
        "avg_casualties": {
          "type": "number",
          "format": "float"
        },
        "games_played": {
          "type": "integer",
          "format": "int64"
        },
        "games_won": {
          "type": "integer",
          "format": "int64"
        },
        "name": {
          "type": "string"
        },
        "player_id": {
          "type": "string"
        }
      }
    },
    "LobbyPlayer": {
      "type": "object",
      "required": [
        "id",
        "is_human",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "is_human": {
          "type": "boolean"
        },
        "llm_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "LobbySettings": {
      "type": "object",
      "required": [
        "map",
        "use_standard_ruleset"
      ],
      "properties": {
        "city_upgrade_settings": {
          "description": "City upgrade and supply system settings",
          "default": {
            "base_supply_range": 5.0,
            "base_upgrade_cost": 200,
            "enabled": false,
            "income_growth_per_level": 0.5,
            "manpower_regen_per_tick": 10.0,
            "max_level": 100,
            "secondary_city_decay": 0.5,
            "supply_range_growth": 3.0
          },
          "allOf": [
            {
              "$ref": "#/definitions/CityUpgradeSettings"
            }
          ]
        },
        "custom_unit_types": {
          "description": "Custom unit types when use_standard_ruleset is false",
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/CustomUnitType"
          }
        },
        "funds_per_city": {
          "default": 0.0,
          "type": "number",
          "format": "float"
        },
        "game_speed": {
          "default": 0.0,
          "type": "number",
          "format": "float"
        },
        "initial_manpower": {
          "description": "Starting manpower pool per player. Always applies when recruiting — not gated behind city upgrades. Used for custom rule sets; the standard ruleset takes its value from the server config.",
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "llm_thinking_delay": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        },
        "map": {
          "type": "string"
        },
        "max_players": {
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "recruitment_rate": {
          "description": "Ticks between recruitment actions for a player (0 = unlimited)",
          "default": 10.0,
          "type": "number",
          "format": "float"
        },
        "spectator_vision": {
          "description": "If true, spectators see union of all players' vision",
          "default": false,
          "type": "boolean"
        },
        "starting_funds": {
          "default": 0,
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "use_standard_ruleset": {
          "type": "boolean"
        },
        "water_speed": {
          "description": "Speed multiplier for water tiles",
          "default": 1.2000000476837158,
          "type": "number",
          "format": "float"
        }
      }
    },
    "PlayerState": {
      "type": "object",
      "required": [
        "funds",
        "player_id",
        "units_owned"
      ],
      "properties": {
        "funds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "player_id": {
          "description": "The connected player's own id (e.g. \"player_a3f2b1c0\"). Empty for spectators.",
          "type": "string"
        },
        "units_owned": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "UnitState": {
      "type": "object",
      "required": [
        "attacking",
        "boat_supply_percent",
        "disembarking",
        "embarking",
        "encircled",
        "equipment",
        "healing",
        "id",
        "max_equipment",
        "max_men",
        "men",
        "on_water",
        "organisation",
        "owner",
        "path",
        "position",
        "resupply_enabled",
        "supply_percent",
        "symbol",
        "unit_type"
      ],
      "properties": {
        "attacking": {
          "type": "boolean"
        },
        "boat_supply_percent": {
          "description": "Boat supply as percentage of max boat supply (0-100)",
          "type": "number",
          "format": "float"
        },
        "disembarking": {
          "description": "Whether this unit is disembarking (transitioning from water to land)",
          "type": "boolean"
        },
        "embarking": {
          "description": "Whether this unit is embarking (transitioning from land to water)",
          "type": "boolean"
        },
        "encircled": {
          "type": "boolean"
        },
        "equipment": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EquipmentState"
          }
        },
        "healing": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "max_equipment": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EquipmentState"
          }
        },
        "max_men": {
          "type": "number",
          "format": "float"
        },
        "men": {
          "type": "number",
          "format": "float"
        },
        "on_water": {
          "description": "Whether this unit is currently traveling on water",
          "type": "boolean"
        },
        "organisation": {
          "type": "number",
          "format": "float"
        },
        "owner": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "number",
                "format": "float"
              },
              {
                "type": "number",
                "format": "float"
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "position": {
          "type": "array",
          "items": [
            {
              "type": "number",
              "format": "float"
            },
            {
              "type": "number",
              "format": "float"
            }
          ],
          "maxItems": 2,
          "minItems": 2
        },
        "resupply_enabled": {
          "type": "boolean"
        },
        "supply_percent": {
          "type": "number",
          "format": "float"
        },
        "symbol": {
          "type": "string"
        },
        "unit_type": {
          "type": "string"
        }
      }
    },
    "UnitUpdate": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "attacking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "boat_supply_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "disembarking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "embarking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "encircled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "equipment": {
          "description": "I3: per-slot equipment COUNTS, in `UnitState.equipment` slot order. Slot names/costs stay in the once-per-lifetime full state (`units_added`/`FullState`), so an equipment change ships only the counts instead of repeating every name + `cost_per_item`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          }
        },
        "healing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "men": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "on_water": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "organisation": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        },
        "path": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": [
              {
                "type": "number",
                "format": "float"
              },
              {
                "type": "number",
                "format": "float"
              }
            ],
            "maxItems": 2,
            "minItems": 2
          }
        },
        "position": {
          "description": "I3: packed quantized position `(x_q << 16) | y_q` — see `pack_unit_position`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "resupply_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "supply_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "float"
        }
      }
    }
  }
}
